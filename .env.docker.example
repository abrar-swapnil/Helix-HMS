# Copy to ".env" (next to docker-compose.yml) before `docker compose up --build`
MYSQL_PASSWORD=change_me_db_password
MYSQL_ROOT_PASSWORD=change_me_root_password
# APP_ENV=development is fine on your own computer. For a server on the internet use production + the two values below.
APP_ENV=development
JWT_SECRET=
STAFF_SIGNUP_CODE=
