# =====================================================================================================
#  Helix HMS - backend settings.   Copy this file to  backend/.env  and edit it.   NEVER commit .env
# =====================================================================================================

# ---- environment ------------------------------------------------------------------------------------
# development: API docs at /docs, random session secret allowed, plain-HTTP cookies (fine for localhost)
# production : refuses to start without JWT_SECRET + STAFF_SIGNUP_CODE, HTTPS-only cookies, docs disabled
APP_ENV=development

# ---- database (MySQL) -------------------------------------------------------------------------------
# mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE     (special characters in the password must be URL-encoded)
DATABASE_URL=mysql+pymysql://helix:change_me@localhost:3306/helix_hms
# Hosted MySQL (Aiven, TiDB Cloud ...) requires an encrypted connection. Use ONE of:
#DB_SSL_CA_PEM=-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----     (certificate TEXT, newlines as \n)
#DB_SSL_CA=/path/to/ca.pem                                                        (certificate FILE)
#DB_SSL=true                                                                      (use the OS trusted CAs)

# ---- security ---------------------------------------------------------------------------------------
# Long random string that signs login sessions. Generate:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
SESSION_HOURS=8
# Admin / receptionist / doctor accounts can only be created with this shared code (patients never need it).
# REQUIRED in production, otherwise anyone on the internet could register as an administrator.
# Leave empty in development to sign up freely.
STAFF_SIGNUP_CODE=
# ALLOW_OPEN_STAFF_SIGNUP=true     # production only: explicitly allow a completely open demo (NOT recommended)
MAX_LOGIN_FAILURES=5
LOGIN_LOCK_MINUTES=15

# ---- one-time passwords (admin + patient sign-in) --------------------------------------------------
# demo  : the code is shown on the login screen (works with no SMS account; NOT real two-factor security)
# twilio: the code is sent by SMS (needs the three TWILIO_* values below)
OTP_MODE=demo
#TWILIO_ACCOUNT_SID=
#TWILIO_AUTH_TOKEN=
#TWILIO_FROM_NUMBER=+15551234567

# ---- hospital details (shown on the landing page and used by the chatbot) --------------------------
HOSPITAL_NAME=Helix HMS
HOSPITAL_TIMEZONE=Asia/Dhaka          # IANA name, e.g. America/New_York. Decides what "today" and "09:00" mean
HOSPITAL_PHONE=+1 (800) 4-HELIX
HOSPITAL_AMBULANCE=+1 (800) HLX-AMBU
HOSPITAL_EMAIL=support@helixhms.com
HOSPITAL_WEBSITE=helixhms.com
EMERGENCY_NUMBER=911                  # put your country's emergency number (the chatbot tells people to call it)
DAY_START=09:00                       # appointment slots start / end each day
DAY_END=17:00
SLOT_MINUTES=30
AVG_CONSULT_MINUTES=8                 # used for the "~N min wait" estimates

# ---- chatbot (Ollama) -------------------------------------------------------------------------------
# Install Ollama (https://ollama.com), then:   ollama pull llama3.2
# If Ollama is not reachable the chatbot automatically switches to "basic mode" (rule-based, same live data).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
#OLLAMA_API_KEY=                      # optional bearer token if Ollama sits behind a reverse proxy
OLLAMA_TIMEOUT=120
CHAT_RATE_PER_MINUTE=12               # per signed-in user / per IP (protects your Ollama machine)

# ---- uploads ---------------------------------------------------------------------------------------
MAX_UPLOAD_MB=5                       # MySQL 5.7 users: also raise max_allowed_packet above this
MAX_DOCS_PER_PATIENT=30
